# Postgres — local docker-compose default; Railway injects its own DATABASE_URL
DATABASE_URL=postgresql+psycopg://tennisbot:tennisbot@localhost:5432/tennisbot

# api-tennis.com (live results gap-filler + 48h schedule)
API_TENNIS_KEY=

# Kalshi — READ-ONLY market access. RSA private key is PEM, base64-encoded into one
# line for env storage (see DEPLOY.md).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_B64=

# Advisory delivery
DISCORD_WEBHOOK_URL=

# Narrative rendering
ANTHROPIC_API_KEY=
